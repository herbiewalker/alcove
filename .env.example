# Alcove — deployment settings. Copy to `.env` (gitignored) and edit.
#
# PATHS AND PORTS ONLY. Never put a key, passphrase or token here (hard constraint 4).
# The data key lives in a key file on a different host path than ALCOVE_DATA_PATH.

# Where the data volume lives on the host (ciphertext only).
ALCOVE_DATA_PATH=/mnt/user/appdata/alcove/data

# The master key FILE. It must NOT be inside ALCOVE_DATA_PATH (the server refuses to start if it is).
# On Unraid the flash drive is separate from the array. Create it once with `alcove keygen`.
ALCOVE_KEY_PATH=/boot/config/alcove/alcove.key

# The host interface and port to publish. Use your server's LAN address, not 0.0.0.0,
# and never forward this port to the internet.
ALCOVE_BIND_IP=127.0.0.1
ALCOVE_PORT=8080

# Image version to run (a release tag such as 0.1.0 once published).
ALCOVE_VERSION=dev

# Timezone for logs.
TZ=UTC

# Resource limits and the in-memory scratch size.
ALCOVE_MEM_LIMIT=2G
ALCOVE_CPU_LIMIT=2.0
ALCOVE_TMPFS_SIZE=1g

# --- Transport security (D-23). All optional; leave them empty to manage these in the admin console.
# A value set here WINS over the console and shows there as "set by environment". It is also the
# break-glass path if a console change ever locks you out: edit it here and recreate the container.
#
# Which networks may reach the server (CIDR ranges, comma separated). Default: private LAN ranges,
# loopback and Tailscale's 100.64.0.0/10. Anything else is refused.
ALCOVE_ALLOWED_NETWORKS=
# Reverse-proxy mode: the proxy addresses whose forwarded client address and protocol are believed.
ALCOVE_TRUSTED_PROXIES=
ALCOVE_PROXY_MODE=
# Refuse sign-ins over plain HTTP (set true once your HTTPS proxy works).
ALCOVE_REQUIRE_TLS=

# --- Instance backups (D-28). A folder for backups, NOT inside ALCOVE_DATA_PATH. Backups are
# ciphertext (useless without the key file), so a different disk or a network share is fine.
ALCOVE_BACKUP_PATH=/mnt/user/backups/alcove
# How many of the newest backups to keep (the newest is never deleted).
ALCOVE_BACKUP_KEEP=7

# --- Uploads (D-29). The largest Tryst backup the server accepts, in MiB (1 to 512). A decrypted
# backup is held in memory while it is read, up to two at once, so keep ALCOVE_MEM_LIMIT above
# twice this plus 1 GiB.
ALCOVE_MAX_UPLOAD_MB=512

# --- Soft delete (D-8, D-30). How long a deleted upload or account can still be restored: by the person
# themselves, and by the administrator. After the administrator window everything is removed for good by a
# purge that runs by itself every hour. The administrator window is never shorter than the person's.
# Time zone for people who have not chosen their own (a name like Europe/Berlin). Empty means UTC.
ALCOVE_TZ=
ALCOVE_USER_RECOVERY_DAYS=10
ALCOVE_ADMIN_RECOVERY_DAYS=45
